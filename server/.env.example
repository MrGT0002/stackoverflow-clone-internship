PORT=5000
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace_with_a_long_random_secret

# Razorpay (Test mode for development, Live mode for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BRONZE=
RAZORPAY_PLAN_SILVER=
RAZORPAY_PLAN_GOLD=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120

# Forgot Password - email delivery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# Forgot Password - SMS delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

RESET_RATE_LIMIT_TIMEZONE=Asia/Kolkata
